APP_NAME=factory-rag-assistant
APP_ENV=development
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8000

MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=/app/storage/uploads
SQLITE_PATH=/app/storage/metadata.db

CHUNK_SIZE_CHARS=600
CHUNK_OVERLAP_CHARS=100
EMBEDDING_MAX_TOKENS=480

EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=factory_knowledge

RETRIEVAL_DEFAULT_TOP_K=5
RETRIEVAL_MAX_TOP_K=10
# 0.55 為目前資料集的校準結果，不適用於所有模型與文件；
# 更換 Embedding、Chunking 或知識庫後必須重新評估。
RETRIEVAL_SCORE_THRESHOLD=0.55

# OpenAI-compatible Chat Completions endpoint（可指向 OpenAI、vLLM、Ollama 等）。
# 本地 vLLM 若不驗證 API Key，可設 LLM_API_KEY=EMPTY。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1000
