APP_NAME=factory-rag-assistant
APP_ENV=development
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8000

MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=/app/storage/uploads
SQLITE_PATH=/app/storage/metadata.db

CHUNK_SIZE_CHARS=600
CHUNK_OVERLAP_CHARS=100
EMBEDDING_MAX_TOKENS=480

EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：
# OpenAI-compatible Embedding API（取代本地 sentence-transformers）。
# 設定後不再從 Hugging Face 下載模型；未設定時 embed_documents / embed_query 將失敗。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=factory_knowledge

RETRIEVAL_DEFAULT_TOP_K=5
RETRIEVAL_MAX_TOP_K=10
# 0.55 為目前資料集的校準結果，不適用於所有模型與文件；
# 更換 Embedding、Chunking 或知識庫後必須重新評估。
RETRIEVAL_SCORE_THRESHOLD=0.55

# OpenAI-compatible Chat Completions endpoint（可指向 OpenAI、vLLM、Ollama 等）。
# 本地 vLLM 若不驗證 API Key，可設 LLM_API_KEY=EMPTY。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1000

# --- v1.1 Retrieval Optimizer（Slice 7 Admin / Slice 8 Read-only Reporting）---
# Admin Write API 預設停用；啟用前請確認你了解 apply/rollback 會切換 Qdrant alias。
# 未設定任何 OPTIMIZER_*_DB_PATH 時，Optimizer UI 一律顯示「無資料」，且不會建立任何 DB。
OPTIMIZER_ADMIN_ENABLED=false
OPTIMIZER_ACTIVE_ALIAS=factory_knowledge_active
# Read-only UI 讀取的三個 SQLite 路徑（分開配置；以 mode=ro 開啟，不建立、不遷移）。
# 例：先用 seeder 產生 demo fixture，再把三個路徑指過來即可在 UI 展示。
#   python -m scripts.seed_optimizer_ui_demo --output-dir evaluation/demo
OPTIMIZER_SEARCH_DB_PATH=
OPTIMIZER_REVIEW_DB_PATH=
OPTIMIZER_DEPLOYMENT_DB_PATH=
